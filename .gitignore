dist/
build/
desktop/dist/
desktop/.vite/

# ── Runtime: logs ─────────────────────────────────────────────────────────────
logs/
*.log
*.jsonl
# …but committed test fixtures are not runtime traces — keep them tracked.
!codex_engine/appserver_schema/*.jsonl
!tests/**/*.jsonl

# ── Runtime: browser session persistence ──────────────────────────────────────
sessions/
kim_sessions/
chrome_data/
.playwright/

# ── Runtime: SQLite databases ─────────────────────────────────────────────────
data/*.sqlite
*.db
*.sqlite
*.sqlite3
relay_server/relay.db

# ── Runtime: scratch / local agent artifacts ──────────────────────────────────
temp/
screenshots/
scratch/
debug_playwright.py
scratch_test_json.py
.claude/worktrees/

# ── OS artifacts ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini

# ── Editor / IDE ──────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── Kim internal tool dirs (not user code) ────────────────────────────────────
.omx/
.clawd-agents/

