.pytest_cache/
.ruff_cache/

# ── Environment secrets (never commit) ───────────────────────────────────────
.env
.env.*
.env.local
.env.*.local
!.env.example
config.yaml

# ── Node.js dependencies ──────────────────────────────────────────────────────
node_modules/

