#!/usr/bin/env bash
# claw-via-browser — run the Claw CLI (interactive REPL or one-shot) but route
# every LLM call through Kim's BrowserProvider instead of the Anthropic API.
# No API key required — the relay drives whichever AI tab is open in your
# CDP-connected Chrome (Gemini, Claude.ai, ChatGPT, Grok).
#
# Usage:
#   ./scripts/claw-via-browser                    # interactive REPL
#   ./scripts/claw-via-browser "fix the bug in main.py"   # one-shot
#   KIM_PROVIDER=browser:claude ./scripts/claw-via-browser
#
# Environment overrides:
#   KIM_PROVIDER   — "browser", "browser:gemini" (default), "browser:claude",
#                    "browser:chatgpt", "browser:grok"
#   CLAW_BIN       — explicit path to the claw binary
#   KIM_ROOT       — explicit path to the kim-pro repo (auto-detected from
#                    this script's location otherwise)
#
# Prerequisites:
#   1. Chrome must be running with --remote-debugging-port=9222 and you must
#      already be signed in to whichever provider you pick. The easiest path
#      is to launch the Kim desktop app once (it spawns Chrome with the right
#      flags), keep that Chrome running, then quit Kim — the browser stays up.
#   2. The kim-pro venv must have BrowserProvider's deps installed
#      (playwright, etc.). If you can run `python -m orchestrator.run_claw_bridge`
#      from inside Kim, those deps are already there.
#
# How it works:
#   • A temp bridge dir is created.
#   • A Python relay process is launched in the background, watching that
#     dir. Its stdio is redirected to a log file so it never paints over
#     claw's TUI.
#   • Once the relay reports ready, claw is exec'd in the foreground with
#     CLAW_FILE_BRIDGE=1 + CLAW_BRIDGE_DIR=<temp> so it talks to the file
#     bridge instead of api.anthropic.com.
#   • When claw exits the relay is killed and the temp dir cleaned up.

set -euo pipefail

SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
KIM_ROOT="${KIM_ROOT:-$( cd "$SCRIPT_DIR/.." && pwd )}"

# ── Resolve the Python interpreter ───────────────────────────────────────────
if [[ -x "$KIM_ROOT/venv/bin/python" ]]; then
  PYTHON="$KIM_ROOT/venv/bin/python"
elif command -v python3 >/dev/null 2>&1; then
  PYTHON="$(command -v python3)"
elif command -v python >/dev/null 2>&1; then
  PYTHON="$(command -v python)"
else
  echo "claw-via-browser: cannot find a Python interpreter." >&2
  exit 1
fi

# ── Resolve the claw binary ──────────────────────────────────────────────────
if [[ -n "${CLAW_BIN:-}" ]]; then
  if [[ ! -x "$CLAW_BIN" ]]; then
    echo "claw-via-browser: CLAW_BIN ($CLAW_BIN) is not executable." >&2
    exit 1
  fi
elif [[ -x "$KIM_ROOT/pythonExperimentTool/claw-code/rust/target/release/claw" ]]; then
  CLAW_BIN="$KIM_ROOT/pythonExperimentTool/claw-code/rust/target/release/claw"
elif [[ -x "$KIM_ROOT/pythonExperimentTool/claw-code/rust/target/debug/claw" ]]; then
  CLAW_BIN="$KIM_ROOT/pythonExperimentTool/claw-code/rust/target/debug/claw"
elif command -v claw >/dev/null 2>&1; then
  CLAW_BIN="$(command -v claw)"
else
  echo "claw-via-browser: cannot find the claw binary. Build it with:" >&2
  echo "  cd $KIM_ROOT/pythonExperimentTool/claw-code/rust && cargo build --release" >&2
  echo "or set CLAW_BIN to its path." >&2
  exit 1
fi

# ── Set up a per-invocation bridge dir ───────────────────────────────────────
BRIDGE_DIR="$(mktemp -d -t claw-via-browser-XXXXXX)"
LOG_FILE="$BRIDGE_DIR/relay.log"
READY_FILE="$BRIDGE_DIR/.relay-ready"

# Always clean up the relay process and temp dir on exit, even on Ctrl-C.
RELAY_PID=""
cleanup() {
  if [[ -n "$RELAY_PID" ]] && kill -0 "$RELAY_PID" 2>/dev/null; then
    kill "$RELAY_PID" 2>/dev/null || true
    # Give it a moment to shut the browser provider down cleanly.
    for _ in 1 2 3 4 5; do
      kill -0 "$RELAY_PID" 2>/dev/null || break
      sleep 0.2
    done
    kill -9 "$RELAY_PID" 2>/dev/null || true
  fi
  rm -rf "$BRIDGE_DIR"
}
trap cleanup EXIT INT TERM

KIM_PROVIDER_ARG="${KIM_PROVIDER:-browser:gemini}"

# ── Launch the relay in the background ───────────────────────────────────────
# PYTHONPATH ensures the relay's `import orchestrator.…` resolves against the
# kim-pro repo regardless of the user's cwd.
PYTHONPATH="$KIM_ROOT" \
  "$PYTHON" -m orchestrator.run_claw_relay \
    --bridge-dir "$BRIDGE_DIR" \
    --provider "$KIM_PROVIDER_ARG" \
    --ready-file "$READY_FILE" \
    >"$LOG_FILE" 2>&1 &
RELAY_PID=$!

# Wait until the relay reports it's connected before launching claw, otherwise
# the very first request can race and time out. 30s is generous — the browser
# provider's CDP attach normally takes <2s.
for _ in $(seq 1 150); do
  if [[ -f "$READY_FILE" ]]; then break; fi
  if ! kill -0 "$RELAY_PID" 2>/dev/null; then
    echo "claw-via-browser: relay exited before becoming ready. Last log lines:" >&2
    tail -n 20 "$LOG_FILE" >&2 || true
    exit 1
  fi
  sleep 0.2
done

if [[ ! -f "$READY_FILE" ]]; then
  echo "claw-via-browser: relay did not report ready within 30s." >&2
  echo "  log: $LOG_FILE" >&2
  exit 1
fi

echo "claw-via-browser: relay ready (provider=$KIM_PROVIDER_ARG)" >&2
echo "  bridge dir: $BRIDGE_DIR" >&2
echo "  relay log:  $LOG_FILE" >&2

# ── Run claw in the foreground with full terminal access ─────────────────────
# stdio is inherited so claw's TUI renders normally; only the LLM transport is
# intercepted via CLAW_FILE_BRIDGE.
CLAW_FILE_BRIDGE=1 \
  CLAW_BRIDGE_DIR="$BRIDGE_DIR" \
  KIM_PROVIDER="$KIM_PROVIDER_ARG" \
  "$CLAW_BIN" "$@"
