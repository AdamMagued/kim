allowed_paths:
- .
use_real_browser: false
browser_provider:
  browser_headless: false
  cdp_url: http://localhost:9222
  # When Chrome isn't already listening on cdp_url (visible mode), open it for
  # you with remote debugging so you can sign in, instead of erroring out with
  # manual launch instructions. Set false to require launching Chrome yourself.
  browser_auto_launch: true
  max_history_messages: 6
  max_inject_chars: 12000
  # Stateful web-chat threads (experimental): one Kim session = one browser
  # thread. The system prompt is sent once per thread; follow-up tasks are
  # small delta messages. Near the context budget (compact_at_ratio) or the
  # turn cap (max_thread_turns), the thread compacts itself into a handoff
  # and Kim continues in a fresh chat seeded with it. When off (default),
  # every message starts a fresh chat and re-sends full context.
  stateful_threads: false
  compact_at_ratio: 0.8
  max_thread_turns: 40
custom_sites: {}
logging:
  level: INFO
max_iterations: 25
# Timeout duration in seconds for in-app browser completions
bridge_timeout_secs: 720
# Duration in milliseconds for the screenshot white flash animation overlay
screenshot_flash_duration_ms: 3300
# IPC event protocol format: "typed" (recommended) or "legacy"
# "typed" emits structured kim:* Tauri events alongside legacy kim-agent-output (dual-emit).
ipc_protocol: typed
max_tokens: 4096
memory_keep_screenshots: 4
memory_max_messages: 40
model:
  claude: claude-opus-4-6
  deepseek: deepseek-chat
  gemini: gemini-2.0-flash
  openai: gpt-4o
openai_api_key_env: OPENAI_API_KEY
openai_base_url: ''
preview_mode: false
project_root: .
provider: ollama
relay:
  pc_api_key: ''
  poll_interval: 2
  url: ''
screenshot_scale: 0.75
shell:
  blocked_commands:
  - rm -rf /
  - 'format c:'
  - del /S /Q C:\
  - rd /S /Q C:\
  timeout: 30
voice:
  enabled: true
  engine: kokoro
  human_quirks: false
  hume:
    description: A warm, clear, and friendly female voice.
    voice_name: Alice Bennett
  maya1:
    max_new_tokens: 2048
    model_id: maya-research/maya1
    speaker_description: A young female with a warm, clear, and natural voice.
    use_4bit: false
  speed: 1.0
  voice_id: af_heart
