{
  "manifest_version": 3,
  "name": "ChatGPT API Bridge",
  "version": "1.0.0",
  "description": "Routes API requests through ChatGPT web chat",
  "permissions": [],
  "host_permissions": [
    "https://chatgpt.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["injected.js"],
      "matches": ["https://chatgpt.com/*"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
